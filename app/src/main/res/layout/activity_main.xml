<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ToggleButton
        android:id="@+id/btnToggleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:textOn="List View"
        android:textOff="Grid View"
        android:checked="false" />

    <EditText
        android:id="@+id/etNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:hint="Nama"
        android:inputType="text" />

    <EditText
        android:id="@+id/etKarakter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Karakter (Pandawa/Punakawan/Kurawa)"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:inputType="text" />

    <EditText
        android:id="@+id/etDeskripsi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Deskripsi"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:inputType="text" />

    <EditText
        android:id="@+id/etFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="URL foto (boleh kosong)"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:inputType="textUri" />

    <Button
        android:id="@+id/btnTambah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tambah" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWayang"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>